# Configuracao para hospedagem publica SaaS (Railway, Render, Fly.io, VPS)
# Em execucao local (localhost), nenhuma dessas variaveis e obrigatoria.

# Permite aceitar requisicoes fora de 127.0.0.1 quando rodando atras de HTTPS/Proxy
RADAR_ALLOW_PUBLIC=1

# Lista separada por virgulas dos dominios autorizados (anti-DNS rebinding)
RADAR_PUBLIC_HOSTS=seu-app.up.railway.app,app.gsnconcursos.com.br

# Exige usuario autenticado para rotas administrativas (1 = producao SaaS)
RADAR_REQUIRE_AUTH=1

# Segredo compartilhado com Kiwify / Hotmart / Asaas / Stripe para liberar planos via POST /api/billing/webhook
RADAR_BILLING_SECRET=troque-por-um-segredo-aleatorio-longo

# Link opcional do checkout (Kiwify / Hotmart / Asaas) para o botao Assinar Plano Pro na tela /planos
RADAR_CHECKOUT_URL=
