{
  "project_root": ".",
  "python": "",
  "db_path": "data/radar.sqlite3",
  "logs_dir": "logs",
  "monitor_interval_hours": 6,
  "queue_interval_hours": 6,
  "batch_limit": 10,
  "source_timeout_seconds": 30,
  "max_documents_per_source": 5,
  "analyze": true,
  "sources": {
    "guajara": {"enabled": true, "min_interval_hours": 6},
    "dou": {"enabled": true, "min_interval_hours": 6},
    "fgv": {"enabled": true, "min_interval_hours": 6},
    "quadrix": {"enabled": true, "min_interval_hours": 6},
    "pci": {"enabled": true, "min_interval_hours": 6}
  },
  "notifications": {
    "local": false,
    "categories": ["prazo_isencao", "retificacao", "falha_fonte"],
    "min_severity": "atencao",
    "max_per_cycle": 5,
    "min_interval_seconds": 30,
    "base_url": "http://127.0.0.1:8000"
  },
  "triage_horizon_days": 7,
  "max_new_alerts_per_cycle": 200,
  "preferences": {
    "reference_municipio": null,
    "reference_uf": null,
    "interest_states": ["BA", "PE"],
    "practical_distance_km": 300,
    "priority": "equilibrado"
  }
}
